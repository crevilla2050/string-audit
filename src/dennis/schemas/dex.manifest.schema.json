{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "payload"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["format", "version", "created_at"],
      "properties": {
        "format": { "type": "string" },
        "version": { "type": "integer" },
        "created_at": { "type": "string" }
      }
    },

    "payload": {
      "type": "object",
      "required": ["type", "hash"],
      "properties": {
        "type": { "type": "string" },

        "hash": {
          "type": "object",
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "type": "string" },
            "value": { "type": "string" }
          }
        }
      }
    },

    "execution": {
      "type": "object"
    },

    "signatures": {
      "type": "array"
    },

    "trust_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "path", "document_type", "document_version", "sha256", "evidence_id"],
      "properties": {
        "profile": {"const": "dennis-dex-trust-evidence-1.0"},
        "path": {"const": "evidence/ilpresim-trust-evidence-1.0.json"},
        "document_type": {"const": "ILP-TRUST-EVIDENCE"},
        "document_version": {"const": "1.0"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_id": {"type": "string", "minLength": 1}
      }
    },

    "regions": {
      "type": "object",
      "required": ["version", "files"],
      "properties": {
        "version": {
          "type": "integer"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "regions"],
            "properties": {
              "file": {
                "type": "string"
              },
              "regions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "file",
                    "start_line",
                    "start_column",
                    "end_line",
                    "end_column",
                    "state",
                    "original",
                    "modified",
                    "hash"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "start_line": {
                      "type": "integer"
                    },
                    "start_column": {
                      "type": "integer"
                    },
                    "end_line": {
                      "type": "integer"
                    },
                    "end_column": {
                      "type": "integer"
                    },
                    "state": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 31
                    },
                    "original": {
                      "type": "string"
                    },
                    "modified": {
                      "type": ["string", "null"]
                    },
                    "hash": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
