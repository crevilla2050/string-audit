{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["meta", "payload"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["format", "version", "created_at"],
      "properties": {
        "format": { "type": "string" },
        "version": { "type": "integer" },
        "created_at": { "type": "string" }
      }
    },

    "payload": {
      "type": "object",
      "required": ["type", "hash"],
      "properties": {
        "type": { "type": "string" },

        "hash": {
          "type": "object",
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "type": "string" },
            "value": { "type": "string" }
          }
        }
      }
    },

    "execution": {
      "type": "object"
    },

    "signatures": {
      "type": "array"
    }
  }
}